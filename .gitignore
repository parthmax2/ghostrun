# GenTest cache (recorded LLM responses live here; usually committed intentionally
# per-project, e.g. examples/.gentest_cache/). The root-level one is where ad-hoc
# local runs of the test suite / gentest doctor happen to write -- not intentional
# content, so it's ignored specifically at the root rather than everywhere.
/.gentest_cache/

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
site/
